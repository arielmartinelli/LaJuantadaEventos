# Copiar a .env.local para desarrollo, y cargar en Vercel > Settings > Environment Variables.
# NUNCA commitear el archivo .env real.

# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública "anon". Es pública por diseño y está protegida por RLS.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave "service_role". SECRETA. Sólo se usa en el servidor (api/), nunca se envía al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Correos autorizados a entrar al panel, separados por coma.
# Si queda vacío, cualquier usuario registrado en Supabase Auth puede administrar el sitio.
ADMIN_EMAILS=lajuntadaeventos@gmail.com

# Orígenes autorizados para peticiones con credenciales, separados por coma.
# Si queda vacío, sólo se acepta el mismo dominio que sirve la API.
ALLOWED_ORIGINS=https://lajuntadaeventos.com.ar,https://www.lajuntadaeventos.com.ar
